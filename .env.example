# Validated at startup by src/api/core/env.ts; api/resume.ts reads the same variables on Vercel.
# Set them on both deploy hosts (Vercel and Appwrite Sites).
VITE_APPWRITE_MAIN_PROJECT_ID=
VITE_APPWRITE_MAIN_ENDPOINT=https://nyc.cloud.appwrite.io/v1

VITE_APPWRITE_DB_ID=

VITE_APPWRITE_DB_PROFILE_COLLECTION_ID=
VITE_APPWRITE_DB_PROJECTS_COLLECTION_ID=
VITE_APPWRITE_DB_BLOG_COLLECTION_ID=
VITE_APPWRITE_DB_SECTION_VISIBILITY_COLLECTION_ID=
VITE_APPWRITE_DB_RESUME_COLLECTION_ID=

# The only storage bucket (the plan allows one). Files are grouped into folders inside it.
VITE_APPWRITE_STORAGE_FILE_BUCKET_ID=

# Optional: id of the view-count Appwrite Function. Defaults to record-blog-view.
# VITE_APPWRITE_FUNCTION_BLOG_VIEW_ID=
